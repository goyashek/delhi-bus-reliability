{
  "name": "delhi-bus-collector",
  "main": "worker.mjs",
  "compatibility_date": "2026-07-30",
  "workers_dev": false,
  "preview_urls": false,
  "triggers": {
    "crons": ["* * * * *"]
  },
  "r2_buckets": [
    {
      "binding": "SNAPSHOTS",
      "bucket_name": "delhi-bus-vehicle-positions"
    }
  ],
  "vars": {
    "OTD_BASE_URL": "https://otd.delhi.gov.in"
  }
}
